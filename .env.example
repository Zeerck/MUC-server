# This is example of .env file. Remove or copy this file and remove '.example' to apply .env variables

# Server
SERVER_ADDRESS=0.0.0.0:1990	    # Address that server will be listening

# Database path.
# If DB_PATH is empty, server will be use this default pathes:
#   For Windows — %APPDATA%/LocalLow/Zeerck Inc/MUC-server/db/database.sqlite
#   For linux — $XDG_DATA_HOME/zeerck-inc/MUC-server/db/database.sqlite
# But if you want to change it, just enter something like that: DB_PATH=./db/database.sqlite 
DB_PATH=

# Timeouts
READ_TIMEOUT=300				# Read timeout (in seconds) to prevent infinite (dead) connections (0 to infinite)
HANDSHAKE_TIMEOUT=10            # Handshake timeout (in seconds) to prevent handshake-ddos atacks

# Certificates required for encryption
TLS_CERT_PATH=/path/to/my.testip.com.crt
TLS_KEY_PATH=/path/to/my.testip.com.crt.key